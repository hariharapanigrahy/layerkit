{
  "id": "tdd-handoff-pr-url-required",
  "title": "TDD RED→GREEN: handoff skill must require client PR URL or residual-no-pr",
  "userIntent": "layerkit: handoff after source-edit",
  "mode": "heal",
  "vendor": "acme",
  "trains": [
    "handoff terminal",
    "critical"
  ],
  "skillText": {
    "skillsUnderTest": [
      "layerkit-session-handoff",
      "layerkit-orchestrate-integration"
    ],
    "mustMatch": [
      "pull/|client PR|github.com/.*/pull",
      "residual-no-pr",
      "gh pr create|pr create|PR opened"
    ],
    "mustNotMatch": []
  },
  "runGold": {
    "mustCiteHosts": [
      "docs.example.com"
    ],
    "requiredPipelineSteps": [
      "discover",
      "surfaces",
      "research",
      "design",
      "author",
      "privacy",
      "deletion-first",
      "source-edit",
      "handoff"
    ],
    "mapFieldsMin": 1,
    "forbidInventFieldPaths": true,
    "forbidStoreOnlyHandoff": true,
    "requirePrUrl": true,
    "allowResidualNoPr": false
  },
  "runs": [
    {
      "id": "good-pr",
      "expectPass": true,
      "artifactsPreset": "good-pr",
      "artifacts": {
        "mapFields": [
          {
            "domain": "a",
            "vendor": "b"
          }
        ],
        "mapIntents": {
          "s": {
            "eventName": "s",
            "operationId": "d"
          }
        },
        "mapOperations": [
          "d"
        ],
        "prUrl": "https://github.com/o/r/pull/1",
        "sourceEditPaths": [
          "a.ts"
        ]
      }
    },
    {
      "id": "bad-store",
      "expectPass": false,
      "artifacts": {
        "mapFields": [
          {
            "domain": "a",
            "vendor": "b"
          }
        ],
        "mapIntents": {
          "s": {
            "eventName": "s",
            "operationId": "d"
          }
        },
        "mapOperations": [
          "d"
        ],
        "documentationUrls": [
          "https://docs.example.com/api"
        ]
      }
    }
  ]
}
