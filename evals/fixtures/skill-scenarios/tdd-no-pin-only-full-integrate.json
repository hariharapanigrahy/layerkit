{
  "id": "tdd-no-pin-only-full-integrate",
  "title": "TDD RED→GREEN: pin/apiVersion alone is not full integrate",
  "userIntent": "layerkit: full integrate acme — agent freestyles apiVersion pin",
  "mode": "full",
  "vendor": "acme",
  "trains": [
    "critical freestyle",
    "orchestrate",
    "no pin-only"
  ],
  "skillText": {
    "skillsUnderTest": [
      "layerkit-orchestrate-integration",
      "layerkit-source-edit-client"
    ],
    "mustMatch": [
      "apiVersion",
      "pin-only|SDK alone|apiVersion alone",
      "not full integrate|not call it full|do not.*full integrate"
    ],
    "mustNotMatch": [
      "out/pr",
      "agent multi"
    ]
  },
  "runGold": {
    "mustCiteHosts": [
      "docs.example.com"
    ],
    "requiredPipelineSteps": [
      "discover",
      "surfaces",
      "research",
      "design",
      "author",
      "privacy",
      "deletion-first",
      "source-edit",
      "handoff"
    ],
    "mapFieldsMin": 1,
    "forbidInventFieldPaths": true,
    "forbidStoreOnlyHandoff": true,
    "requirePrUrl": true,
    "allowResidualNoPr": false
  },
  "runs": [
    {
      "id": "good-real-edit-pr",
      "expectPass": true,
      "artifactsPreset": "good-pr",
      "artifacts": {
        "documentationUrls": [
          "https://docs.example.com/api",
          "https://docs.example.com/changelog"
        ],
        "prUrl": "https://github.com/example-org/customer-package/pull/1225"
      }
    },
    {
      "id": "bad-store-only",
      "expectPass": false,
      "artifacts": {
        "mapFields": [
          {
            "domain": "a",
            "vendor": "b"
          }
        ],
        "mapIntents": {
          "s": {
            "eventName": "s",
            "operationId": "d"
          }
        },
        "mapOperations": [
          "d"
        ],
        "documentationUrls": [
          "https://docs.example.com/api"
        ]
      }
    }
  ]
}
