{
  "id": "tdd-e2e-mergeable-integration-developer",
  "title": "TDD: integration developer E2E \u2014 docs evidence \u2192 map \u2192 production edit \u2192 verify \u2192 PR (no freestyle complete)",
  "userIntent": "layerkit: heal acme customer package end-to-end until PR is mergeable",
  "mode": "heal",
  "vendor": "acme",
  "trains": [
    "integration developer",
    "docs understanding enforced",
    "code map fix verified",
    "PR required",
    "no human-only audit as success"
  ],
  "skillText": {
    "skillsUnderTest": [
      "layerkit-orchestrate-integration",
      "layerkit-research-vendor",
      "layerkit-author-map",
      "layerkit-source-edit-client",
      "layerkit-session-handoff"
    ],
    "mustMatch": [
      "OpenAPI|docs|changelog",
      "do not invent|never invent|do not guess",
      "production source|existing",
      "residual-no-field-edit",
      "apiVersion",
      "client PR|pull/|gh pr create|PR opened",
      "residual-no-pr",
      "package.*(test|build|verification)|Client package"
    ],
    "mustNotMatch": [
      "store-only is success",
      "human review is the only quality gate"
    ]
  },
  "runGold": {
    "mustCiteHosts": [
      "docs.example.com"
    ],
    "requiredPipelineSteps": [
      "discover",
      "surfaces",
      "research",
      "design",
      "author",
      "privacy",
      "deletion-first",
      "source-edit",
      "handoff"
    ],
    "mapFieldsMin": 1,
    "forbidInventFieldPaths": true,
    "forbidStoreOnlyHandoff": true,
    "requirePrUrl": true,
    "allowResidualNoPr": false
  },
  "runs": [
    {
      "id": "good-mergeable-chain",
      "expectPass": true,
      "transcript": {
        "id": "e2e-good",
        "scenarioId": "tdd-e2e-mergeable-integration-developer",
        "vendor": "acme",
        "title": "Full chain: cited docs, map, production edit, package verify, PR",
