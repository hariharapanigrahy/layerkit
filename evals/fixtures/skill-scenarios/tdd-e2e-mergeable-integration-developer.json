                "excerpt": "amount, currency required"
              },
              {
                "title": "API versioning",
                "url": "https://docs.example.com/api/versioning",
                "excerpt": "apiVersion is not a substitute for field contract"
              }
            ],
            "invent": false,
            "deepened": true,
            "askedHuman": false,
            "notes": "severity residual; changelog reviewed"
