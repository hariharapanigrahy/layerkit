{
  "id": "tdd-e2e-mergeable-integration-developer",
  "title": "TDD: integration developer E2E — docs evidence → map → production edit → verify → PR (no freestyle complete)",
  "userIntent": "layerkit: heal acme customer package end-to-end until PR is mergeable",
  "mode": "heal",
  "vendor": "acme",
  "trains": [
    "integration developer",
    "docs understanding enforced",
    "code map fix verified",
    "PR required",
    "no human-only audit as success"
  ],
  "skillText": {
    "skillsUnderTest": [
      "layerkit-orchestrate-integration",
      "layerkit-research-vendor",
      "layerkit-author-map",
      "layerkit-source-edit-client",
      "layerkit-session-handoff"
    ],
    "mustMatch": [
      "OpenAPI|docs|changelog",
      "do not invent|never invent|do not guess",
      "production source|existing",
      "residual-no-field-edit",
      "apiVersion",
      "client PR|pull/|gh pr create|PR opened",
      "residual-no-pr",
      "package.*(test|build|verification)|Client package"
    ],
    "mustNotMatch": [
      "store-only is success",
      "human review is the only quality gate"
    ]
  },
  "runGold": {
    "mustCiteHosts": [
      "docs.example.com"
    ],
    "requiredPipelineSteps": [
      "discover",
      "surfaces",
      "research",
      "design",
      "author",
      "privacy",
      "deletion-first",
      "source-edit",
      "handoff"
    ],
    "mapFieldsMin": 1,
    "forbidInventFieldPaths": true,
    "forbidStoreOnlyHandoff": true,
    "requirePrUrl": true,
    "allowResidualNoPr": false
  },
  "runs": [
    {
      "id": "good-mergeable-chain",
      "expectPass": true,
      "artifactsPreset": "good-pr",
      "artifacts": {
        "mapFields": [
          {
            "domain": "amount",
            "vendor": "amount"
          },
          {
            "domain": "currency",
            "vendor": "currency"
          }
        ],
        "mapIntents": {
          "purchase": {
            "eventName": "payment_intent",
            "operationId": "default"
          }
        },
        "documentationUrls": [
          "https://docs.example.com/api/payment_intents/create",
          "https://docs.example.com/api/versioning"
        ],
        "prUrl": "https://github.com/acme/client/pull/42"
      }
    },
    {
      "id": "bad-store-only-complete",
      "expectPass": false,
      "steps": [
        {
          "id": "tdd-e2e-mergeable-integration-developer-surfaces",
          "pipelineStep": "surfaces",
          "skill": "layerkit-inventory-surfaces",
          "action": "surfaces",
          "claim": "Inventoried languages for tdd-e2e-mergeable-integration-developer",
          "sources": [
            {
              "title": "layout",
              "url": "file://package",
              "excerpt": "server/node server/python"
            }
          ],
          "invent": false,
          "deepened": true,
          "askedHuman": false
        },
        {
          "id": "research-stub",
          "pipelineStep": "research",
          "skill": "layerkit-research-vendor",
          "action": "research",
          "claim": "severity residual drift residual OpenAPI docs reviewed",
          "sources": [
            {
              "title": "stub",
              "url": "https://docs.example.com/api",
              "excerpt": "keywords only"
            }
          ],
          "invent": false,
          "deepened": true,
          "askedHuman": false
        },
        {
          "id": "handoff-stub",
          "pipelineStep": "handoff",
          "skill": "layerkit-session-handoff",
          "action": "handoff",
          "claim": "goal done next none blocked none quality residual",
          "sources": [
            {
              "title": "memory",
              "url": "file://memory/handoff.md",
              "excerpt": "store only"
            }
          ],
          "invent": false,
          "deepened": true,
          "askedHuman": false
        }
      ],
      "artifacts": {
        "mapFields": [
          {
            "domain": "amount",
            "vendor": "amount"
          }
        ],
        "mapIntents": {
          "sample": {
            "eventName": "sample",
            "operationId": "default"
          }
        },
        "mapOperations": [
          "default"
        ],
        "documentationUrls": [
          "https://docs.example.com/api"
        ]
      }
    },
    {
      "id": "bad-pin-only-pr",
      "expectPass": false,
      "steps": [
        {
          "id": "tdd-e2e-mergeable-integration-developer-surfaces",
          "pipelineStep": "surfaces",
          "skill": "layerkit-inventory-surfaces",
          "action": "surfaces",
          "claim": "Inventoried languages for tdd-e2e-mergeable-integration-developer",
          "sources": [
            {
              "title": "layout",
              "url": "file://package",
              "excerpt": "server/node server/python"
            }
          ],
          "invent": false,
          "deepened": true,
          "askedHuman": false
        },
        {
          "id": "research",
          "pipelineStep": "research",
          "skill": "layerkit-research-vendor",
          "action": "research",
          "claim": "Only bumped apiVersion; no field contract work",
          "sources": [
            {
              "title": "versioning",
              "url": "https://docs.example.com/api/versioning",
              "excerpt": "apiVersion"
            }
          ],
          "invent": false,
          "deepened": true,
          "askedHuman": false
        },
        {
          "id": "source-edit",
          "pipelineStep": "source-edit",
          "skill": "layerkit-source-edit-client",
          "action": "source-edit",
          "claim": "Changed apiVersion string only",
          "sources": [
            {
              "title": "pin",
              "url": "file://package.json",
              "excerpt": "apiVersion bump"
            }
          ],
          "invent": false,
          "deepened": true,
          "askedHuman": false
        },
        {
          "id": "handoff",
          "pipelineStep": "handoff",
          "skill": "layerkit-session-handoff",
          "action": "handoff",
          "claim": "Opened PR with pin-only",
          "sources": [
            {
              "title": "pr",
              "url": "https://github.com/acme/client/pull/99",
              "excerpt": "apiVersion only"
            }
          ],
          "invent": false,
          "deepened": true,
          "askedHuman": false
        }
      ],
      "artifacts": {
        "mapFields": [],
        "mapIntents": {},
        "mapOperations": [],
        "documentationUrls": [
          "https://docs.example.com/api/versioning"
        ],
        "sourceEditPaths": [
          "package.json"
        ],
        "prUrl": "https://github.com/acme/client/pull/99"
      }
    }
  ]
}
