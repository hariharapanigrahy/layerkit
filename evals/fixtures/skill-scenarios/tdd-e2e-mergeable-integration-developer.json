          {
            "id": "discover",
            "pipelineStep": "discover",
            "skill": "layerkit-discover-data-layer",
            "action": "discover",
            "claim": "Customer domain fields amount currency from source:code file://server/server.js",
            "sources": [
              {
                "title": "client server",
                "url": "file://server/server.js",
                "excerpt": "paymentIntents.create amount currency"
              }
            ],
            "invent": false,
            "deepened": true,
            "askedHuman": false
          },
          {
