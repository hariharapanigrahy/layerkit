{
  "id": "hybrid-heal-no-fake-cli",
  "title": "Skills must not describe fake deterministic heal CLI parsers",
  "userIntent": "layerkit: heal from docs link",
  "mode": "heal",
  "vendor": "acme",
  "trains": [
    "skill text",
    "hybrid heal",
    "agent-owned"
  ],
  "skillText": {
    "skillsUnderTest": [
      "layerkit-research-vendor",
      "layerkit-orchestrate-integration",
      "layerkit-source-edit-client"
    ],
    "mustMatch": [
      "AI agent|agent-owned|agent",
      "docs|OpenAPI"
    ],
    "mustNotMatch": [
      "layerkit heal run",
      "contract-from-doc",
      "agent multi"
    ]
  },
  "runGold": {
    "mustCiteHosts": [
      "docs.example.com"
    ],
    "requiredPipelineSteps": [
      "discover",
      "surfaces",
      "research",
      "design",
      "author",
      "privacy",
      "deletion-first",
      "source-edit",
      "handoff"
    ],
    "mapFieldsMin": 1,
    "forbidInventFieldPaths": true,
    "forbidStoreOnlyHandoff": true,
    "requirePrUrl": true,
    "allowResidualNoPr": false
  },
  "runs": [
    {
      "id": "good",
      "expectPass": true,
      "artifactsPreset": "good-pr"
    },
    {
      "id": "bad-store",
      "expectPass": false,
      "artifacts": {
        "mapFields": [
          {
            "domain": "a",
            "vendor": "b"
          }
        ],
        "documentationUrls": [
          "https://docs.example.com/api"
        ],
        "mapIntents": {
          "s": {
            "eventName": "s",
            "operationId": "default"
          }
        },
        "mapOperations": [
          "default"
        ]
      }
    }
  ]
}
