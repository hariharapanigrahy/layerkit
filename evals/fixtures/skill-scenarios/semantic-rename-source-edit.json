{
  "id": "semantic-rename-source-edit",
  "title": "Rename only from evidence; edit existing mapper",
  "userIntent": "layerkit: heal vendor renamed email to email_id",
  "mode": "heal",
  "vendor": "acme",
  "trains": [
    "source-edit",
    "rename",
    "no guess"
  ],
  "skillText": {
    "skillsUnderTest": [
      "layerkit-source-edit-client",
      "layerkit-research-vendor"
    ],
    "mustMatch": [
      "evidence",
      "rename|update existing"
    ],
    "mustNotMatch": []
  },
  "runGold": {
    "mustCiteHosts": [
      "docs.example.com"
    ],
    "requiredPipelineSteps": [
      "discover",
      "surfaces",
      "research",
      "design",
      "author",
      "privacy",
      "deletion-first",
      "source-edit",
      "handoff"
    ],
    "mapFieldsMin": 1,
    "forbidInventFieldPaths": true,
    "forbidStoreOnlyHandoff": true,
    "requirePrUrl": true,
    "allowResidualNoPr": false
  },
  "runs": [
    {
      "id": "good-rename-edit",
      "expectPass": true,
      "artifactsPreset": "good-pr",
      "artifacts": {
        "mapFields": [
          {
            "domain": "user.email",
            "vendor": "email_id"
          }
        ],
        "sourceEditPaths": [
          "src/mapper.ts"
        ]
      }
    },
    {
      "id": "bad-invent-rename",
      "expectPass": false,
      "stepOverrides": {
        "author": {
          "invent": true
        }
      },
      "artifactsPreset": "good-pr",
      "artifacts": {
        "mapFields": [
          {
            "domain": "amount",
            "vendor": "invent_email"
          }
        ]
      }
    }
  ]
}
