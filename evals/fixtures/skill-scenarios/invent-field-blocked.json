{
  "id": "invent-field-blocked",
  "title": "Invented map fields must fail agent-run judge",
  "userIntent": "layerkit: author map for acme (evidence required)",
  "mode": "heal",
  "vendor": "acme",
  "trains": [
    "mapper",
    "no invent",
    "author-map"
  ],
  "skillText": {
    "skillsUnderTest": [
      "layerkit-author-map",
      "layerkit-research-vendor"
    ],
    "mustMatch": [
      "do not invent",
      "sources"
    ],
    "mustNotMatch": [
      "guess the field"
    ]
  },
  "runGold": {
    "mustCiteHosts": [
      "docs.example.com"
    ],
    "requiredPipelineSteps": [
      "discover",
      "surfaces",
      "research",
      "design",
      "author",
      "privacy",
      "deletion-first",
      "source-edit",
      "handoff"
    ],
    "mapFieldsMin": 1,
    "forbidInventFieldPaths": true,
    "forbidStoreOnlyHandoff": true,
    "requirePrUrl": true,
    "allowResidualNoPr": false
  },
  "runs": [
    {
      "id": "good-cited-fields",
      "expectPass": true,
      "artifactsPreset": "good-pr"
    },
    {
      "id": "bad-invent",
      "expectPass": false,
      "defect": "invent",
      "stepOverrides": {
        "author": {
          "invent": true
        }
      },
      "artifactsPreset": "good-pr",
      "artifacts": {
        "mapFields": [
          {
            "domain": "amount",
            "vendor": "invent_email"
          }
        ]
      }
    }
  ]
}
