{
  "id": "tdd-contract-field-renames",
  "title": "TDD RED→GREEN: contract renames only from docs; edit production fields",
  "userIntent": "layerkit: heal acme package contract renames (confirmation_token, create_invoice_preview)",
  "mode": "heal",
  "vendor": "acme",
  "trains": [
    "critical rename",
    "research",
    "source-edit"
  ],
  "skillText": {
    "skillsUnderTest": [
      "layerkit-research-vendor",
      "layerkit-source-edit-client",
      "layerkit-author-map"
    ],
    "mustMatch": [
      "changelog|OpenAPI|docs",
      "rename",
      "do not guess|never guess|not guess",
      "production source|edit existing|existing mapper"
    ],
    "mustNotMatch": []
  },
  "runGold": {
    "mustCiteHosts": [
      "docs.example.com"
    ],
    "requiredPipelineSteps": [
      "discover",
      "surfaces",
      "research",
      "design",
      "author",
      "privacy",
      "deletion-first",
      "source-edit",
      "handoff"
    ],
    "mapFieldsMin": 1,
    "forbidInventFieldPaths": true,
    "forbidStoreOnlyHandoff": true,
    "requirePrUrl": true,
    "allowResidualNoPr": false
  },
  "runs": [
    {
      "id": "good-renamed-fields",
      "expectPass": true,
      "artifactsPreset": "good-pr",
      "artifacts": {
        "mapFields": [
          {
            "domain": "payment.confirmation",
            "vendor": "confirmation_token"
          },
          {
            "domain": "invoice.preview",
            "vendor": "create_invoice_preview"
          }
        ],
        "documentationUrls": [
          "https://docs.example.com/api",
          "https://docs.example.com/changelog"
        ],
        "prUrl": "https://github.com/example-org/customer-package/pull/1225",
        "sourceEditPaths": [
          "server/server.js",
          "fixed-price-subscriptions/server/server.js"
        ]
      }
    },
    {
      "id": "bad-invent-rename",
      "expectPass": false,
      "stepOverrides": {
        "author": {
          "invent": true
        }
      },
      "artifactsPreset": "good-pr",
      "artifacts": {
        "mapFields": [
          {
            "domain": "user.email",
            "vendor": "invent_email"
          }
        ],
        "documentationUrls": [
          "https://docs.example.com/api",
          "https://docs.example.com/changelog"
        ],
        "prUrl": "https://github.com/example-org/customer-package/pull/1225"
      }
    }
  ]
}
