{
  "schemaVersion": 1,
  "id": "default",
  "version": "1.0.0",
  "description": "Fixture: segment field selects vendor set; product id expands a secondary intent",
  "vendorSets": [
    {
      "id": "set_all",
      "vendors": ["vendor_a", "vendor_b", "vendor_c"]
    },
    {
      "id": "set_narrow",
      "vendors": ["vendor_a"]
    },
    {
      "id": "set_secondary",
      "vendors": ["vendor_b", "vendor_c"]
    }
  ],
  "expansions": [
    {
      "id": "exp_secondary_product",
      "when": { "op": "in", "path": "product.id", "value": ["sku_special", "sku_promo"] },
      "emit": [{ "intent": "secondary_intent" }],
      "keepBaseIntent": true
    }
  ],
  "routes": [
    {
      "id": "route_base_narrow",
      "priority": 10,
      "intent": "base_intent",
      "when": { "op": "eq", "path": "context.segment", "value": "narrow" },
      "to": "set_narrow",
      "stop": true
    },
    {
      "id": "route_base_all",
      "priority": 5,
      "intent": "base_intent",
      "to": "set_all"
    },
    {
      "id": "route_secondary",
      "intent": "secondary_intent",
      "to": "set_secondary"
    }
  ],
  "requireRouteMatch": false,
  "maxExpansionDepth": 3
}
