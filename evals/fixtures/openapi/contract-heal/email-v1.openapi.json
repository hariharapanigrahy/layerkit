{
  "openapi": "3.0.3",
  "info": {
    "title": "Contract Heal Email Fixture",
    "version": "1.0.0",
    "description": "Generic transactional email contract used by heal and drift evals."
  },
  "servers": [{ "url": "https://api.email-fixture.test" }],
  "paths": {
    "/emails": {
      "post": {
        "operationId": "sendEmail",
        "summary": "Send email",
        "x-ikg-domain-op": "notify.sendEmail",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["from", "to", "subject"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "array", "items": { "type": "string" } },
                  "subject": { "type": "string" },
                  "text": { "type": "string" },
                  "html": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "id": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
