{
  "openapi": "3.0.3",
  "info": { "title": "Notify API fixture", "version": "1.0.0" },
  "servers": [{ "url": "https://api.example-notify.test" }],
  "paths": {
    "/messages": {
      "post": {
        "operationId": "sendMessage",
        "summary": "Send a message",
        "x-acme-domain-op": "notify.send",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["to", "subject"],
                "properties": {
                  "to": { "type": "string" },
                  "subject": { "type": "string" },
                  "text": { "type": "string" },
                  "email": { "type": "string", "description": "optional reply-to" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/messages/{id}": {
      "get": {
        "operationId": "getMessage",
        "x-other-domain-op": "notify.get",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    }
  }
}
