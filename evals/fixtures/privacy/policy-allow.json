{
  "schemaVersion": 2,
  "id": "default-allow",
  "version": "1.0.0",
  "description": "Minimal allow policy with denylist on raw email wire path",
  "defaultAction": "allow",
  "rules": [
    {
      "id": "consent-marketing",
      "action": "require_consent",
      "purposes": ["marketing"]
    }
  ],
  "egressChecks": [
    {
      "type": "field_denylist",
      "config": {
        "fields": ["user.email", "user_data.email_raw"]
      }
    }
  ]
}
