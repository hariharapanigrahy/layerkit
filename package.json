{
  "name": "layerkit",
  "version": "0.1.3",
  "description": "Agent-first multi-vendor data-layer toolkit: install skills/hooks into Codex, Claude Code, Cursor, Copilot, OpenCode, OpenHands; research vendor docs; proposal pipeline; client-source editing; evals.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "author": "Harihara Panigrahy <hhp263@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hariharapanigrahy/layerkit.git"
  },
  "homepage": "https://github.com/hariharapanigrahy/layerkit#readme",
  "bugs": {
    "url": "https://github.com/hariharapanigrahy/layerkit/issues"
  },
  "keywords": [
    "data-layer",
    "multi-vendor",
    "ai-agents",
    "codex",
    "claude-code",
    "cursor",
    "copilot",
    "opencode",
    "openhands",
    "java",
    "field-mapping",
    "evals",
    "integrations"
  ],
  "bin": {
    "layerkit": "dist/apps/cli/main.js"
  },
  "exports": {
    "./store": {
      "types": "./dist/libs/vendor-memory/store.d.ts",
      "import": "./dist/libs/vendor-memory/store.js",
      "default": "./dist/libs/vendor-memory/store.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "store": [
        "dist/libs/vendor-memory/store.d.ts"
      ]
    }
  },
  "files": [
    "dist/apps/cli/main.js",
    "dist/apps/cli/main.js.map",
    "dist/apps/cli/main.d.ts",
    "dist/apps/cli/main.d.ts.map",
    "dist/libs",
    "skills",
    "docs/AGENT_FIRST.md",
    "docs/AGENT_GOLDEN_PATH.md",
    "docs/CHEATSHEET.md",
    "docs/API_STABILITY.md",
    "docs/agent-install-prompt.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "MATURITY.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "pack:check": "npm pack --dry-run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test": "npm run build && node scripts/check-install-options.js && node scripts/check-proposal-validate.js && node --test dist/apps/cli/empty-state.test.js dist/evals/vendor-research-plan/generate-cases.test.js && npm run test:unit && npm run test:coverage",
    "smoke:codex": "npm run build && node scripts/smoke-codex.mjs",
    "smoke:claude": "npm run build && node scripts/smoke-claude.mjs",
    "smoke:cursor": "npm run build && node scripts/smoke-cursor.mjs",
    "smoke:copilot": "npm run build && node scripts/smoke-copilot.mjs",
    "smoke:opencode": "npm run build && node scripts/smoke-opencode.mjs",
    "smoke:openhands": "npm run build && node scripts/smoke-openhands.mjs",
    "smoke:devin": "npm run build && node scripts/smoke-devin.mjs",
    "smoke:windsurf": "npm run build && node scripts/smoke-windsurf.mjs",
    "eval:ci": "npm run build && node dist/evals/harness/runner.js --suite ci",
    "eval:all": "npm run build && node dist/evals/harness/runner.js --suite all",
    "eval:proposal-sources": "npm run build && node dist/evals/harness/runner.js --case proposal-sources-required",
    "eval:install-platforms": "npm run build && node dist/evals/harness/runner.js --case install-platforms",
    "eval:map-quality": "npm run build && node dist/evals/map-quality-optimizer/train.js",
    "eval:vendor-research-plan": "npm run build && node dist/evals/vendor-research-plan/run.js",
    "eval:agent-judge": "npm run build && node scripts/run-agent-judge.mjs",
    "layerkit": "node dist/apps/cli/main.js",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.8.3",
    "vitest": "^2.0.0"
  }
}
